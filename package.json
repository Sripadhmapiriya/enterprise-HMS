{
  "name": "enterprise-hms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:params": "node scripts/check-params.mjs",
    "test": "vitest run",
    "verify": "npm run check:params && npm run typecheck && npm run test && tsx scripts/verify-integrity.ts && npm run check:no-hardcoded-colors",
    "check:integrity": "tsx scripts/verify-integrity.ts",
    "check:no-phase": "tsx scripts/verify-integrity.ts",
    "check:no-hardcoded-colors": "tsx scripts/check-no-hardcoded-colors.ts",
    "provision": "tsx scripts/provision.ts",
    "build:edition": "tsx scripts/build-edition.ts",
    "issue:license": "tsx scripts/issue-license.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.7.0",
    "turbo": "^2.11.7",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@9.5.1"
}
